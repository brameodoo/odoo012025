<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="workshop_request_view_form" model="ir.ui.view">
            <field name="name">workshop.request.form</field>
            <field name="model">workshop.request</field>
            <field name="arch" type="xml">
                <form string="Solicitud de Taller">
                    <sheet>
                        <group>
                            <group string="Información del Vehículo">
                                <field name="vehicle_id" required="1"/>
                                <field name="driver_id"/>
                            </group>
                            <group string="Detalles de la Solicitud">
                                <field name="request_date" required="1"/>
                                <field name="description"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Diagnóstico y Reparación">
                                <field name="diagnosis"/>
                                <field name="repair_details"/>
                                <field name="workshop_id"/>
                                <field name="estimated_cost"/>
                                <field name="repair_date"/>
                            </page>
                            <page string="Estado">
                                <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done,cancelled"/>
                                <field name="notes"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="fleet_workshop_request_view_tree" model="ir.ui.view">
            <field name="name">workshop.request.form</field>
            <field name="model">workshop.request</field>
            <field name="arch" type="xml">
                <tree string="Solicitudes de Taller">
                    <field name="name"/>
                    <field name="vehicle_id"/>
                    <field name="request_date"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="fleet_workshop_request_view_kanban" model="ir.ui.view">
            <field name="name">fleet.workshop.request.kanban</field>
            <field name="model">fleet.workshop.request</field>
            <field name="arch" type="xml">
                <kanban class="oe_background_ Grey">
                    <field name="name"/>
                    <field name="vehicle_id"/>
                    <field name="request_date"/>
                    <field name="state"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global">
                                <div class="oe_kanban_details">
                                    <strong><field name="name"/></strong>
                                    <ul>
                                        <li>Vehículo: <field name="vehicle_id"/></li>
                                        <li>Fecha de Solicitud: <field name="request_date"/></li>
                                        <li>Estado: <field name="state"/></li>
                                    </ul>
                                </div>
                                <div class="oe_kanban_buttons">
                                    <button name="%(fleet_workshop_request_action)d" type="action" class="oe_kanban_button_extend" icon="fa-pencil"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="fleet_workshop_request_action" model="ir.actions.act_window">
            <field name="name">Solicitudes de Taller</field>
            <field name="res_model">fleet.workshop.reques</field>
            <field name="view_mode">tree,form,kanban</field>
        </record>

        <menuitem id="fleet_workshop_request_menu_root" name="Taller de Flota" sequence="30" web_icon="fleet_car_workshop_request,static/description/icon.png"/>

        <menuitem id="fleet_workshop_request_menu_action" name="Solicitudes" parent="fleet_workshop_request_menu_root" action="fleet_workshop_request_action" sequence="10"/>
    </data>
</odoo>
