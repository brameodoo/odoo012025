
<odoo>
    <data>
        <record id="email_template_workshop_request_confirmation" model="mail.template">
            <field name="name">Solicitud de Taller Confirmada</field>
            <field name="model_id" ref="model_workshop_request"/>
            <field name="subject">Su solicitud de taller para el vehículo {{ object.vehicle_id.name }} ha sido confirmada</field>
            <field name="body_html"><![CDATA[
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Estimado(a) ${object.analyst_id.name},
        <br/>
        <br/>
        Su solicitud de ingreso al taller para el vehículo ${object.vehicle_id.name} ha sido confirmada.
        <br/>
        <strong>Fecha de asignación:</strong> ${object.assignment_date}
        <br/>
        <br/>
        Gracias,
    </p>
</div>
            ]]></field>
            <field name="email_from">${(object.analyst_id.email_formatted) or ''}</field>
            <field name="email_to">${(object.analyst_id.email_formatted) or ''}</field>
        </record>
    </data>
</odoo>
