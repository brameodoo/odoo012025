<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_picking_wizard_form" model="ir.ui.view">
        <field name="name">stock.picking.wizard.form</field>
        <field name="model">stock.picking.wizard</field>
        <field name="arch" type="xml">
            <form string="Crear Stock Picking">
                <group>
                    <field name="workshop_id" readonly="1"/>
                    <field name="picking_type_id"/>
                    <field name="location_id"/>
                    <field name="location_dest_id"/>
                </group>
                <field name="product_lines">
                    <tree editable="bottom">
                        <field name="product_id"/>
                        <field name="quantity"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_create_picking" string="Crear Picking" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_picking_wizard" model="ir.actions.act_window">
        <field name="name">Crear Stock Picking</field>
        <field name="res_model">stock.picking.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
